import { supabaseClient } from "@/config/supabase";
import * as FileSystem from 'expo-file-system';
import {
    type ChatFromBackendType,
    type MessageFromBackendType,
    type ProjectMessageFromBackendType,
} from "@/types";

export async function getChatsForUser({
    userId,
    userRole,
    getDetails,
}: {
    userId: string;
    userRole: "freelancer" | "client";
    getDetails: boolean;
}): Promise<ChatFromBackendType[]> {
    const column = userRole === "client" ? "client_id" : "freelancer_id";

    console.log(`[getChatsForUser] Querying with:`, {
        userId,
        userRole,
        column,
        getDetails
    });

    const { data, error } = await supabaseClient
        .from("chats")
        .select("*")
        .eq(column, userId)
        .order("created_at", { ascending: false });
    
    console.log(`[getChatsForUser] Query result:`, {
        found: data?.length || 0,
        userId,
        userRole,
        column,
        rawData: data
    });
    
    if (error) {
        console.log("[getChatsForUser] Error:", error.message, error);
        throw new Error(error.message);
    }

    if (!data || data.length === 0) {
        console.log("[getChatsForUser] No chats found, returning empty array");
        return [];
    }

    if (!getDetails) return data;

    const otherUserColumn = userRole === "client" ? "freelancer_id" : "client_id";
    const otherUserIds = data.map((chat) => chat[otherUserColumn]);
    const otherUserTable = userRole === "client" ? "freelancers" : "clients";

    // Only fetch users if there are any
    let usersData = [];
    if (otherUserIds.length > 0) {
        const { data: fetchedUsers, error: usersError } = await supabaseClient
            .from(otherUserTable)
            .select("id, username, profile_pic")
            .in("id", otherUserIds);
        if (usersError) {
            console.log("Error occurred in getChatsForUser function", usersError.message);
            throw new Error(usersError.message);
        }
        usersData = fetchedUsers || [];
    }

    // Fetch latest messages for each chat
    const chatIds = data.map((chat) => chat.id);
    let messagesData = [];
    if (chatIds.length > 0) {
        const { data: fetchedMessages, error: messagesError } = await supabaseClient
            .from("messages")
            .select("id, chat_id, message_text, sender_role, created_at")
            .in("chat_id", chatIds)
            .order("created_at", { ascending: false });
        
        if (messagesError) {
            console.log("Error fetching messages in getChatsForUser", messagesError.message);
        } else {
            messagesData = fetchedMessages || [];
        }
    }

    const lastReadColumn = userRole === "client" ? "last_read_message_id_client" : "last_read_message_id_freelancer";
    
    const chatsWithUserDetails = data.map((chat) => {
        const userDetails = usersData.find((user) => user.id === chat[otherUserColumn]);
        
        // Find the latest message for this chat
        const latestMessage = messagesData?.find((msg) => msg.chat_id === chat.id);
        
        // Calculate unseen message count - only count messages from the OTHER person
        const lastReadMessageId = chat[lastReadColumn];
        
        // Get all messages for this chat
        const chatMessages = messagesData?.filter((msg) => msg.chat_id === chat.id) || [];
        const messagesFromOther = chatMessages.filter((msg) => msg.sender_role !== userRole);
        const unseenMessages = messagesFromOther.filter((msg) => !lastReadMessageId || msg.id > lastReadMessageId);
        const unseenCount = unseenMessages.length;
        
        return { 
            ...chat, 
            userDetails,
            latestMessage: latestMessage ? {
                message_text: latestMessage.message_text,
                sender_role: latestMessage.sender_role,
                created_at: latestMessage.created_at,
            } : undefined,
            unseenCount
        };
    });
    
    console.log(`getChatsForUser: Returning ${chatsWithUserDetails.length} chats with details`);
    return chatsWithUserDetails;
}

export async function getUnseenChatsCount({
    userId,
    userRole,
}: {
    userId: string;
    userRole: "freelancer" | "client";
}): Promise<number> {
    const column = userRole === "client" ? "client_id" : "freelancer_id";
    const lastReadColumn = userRole === "client" ? "last_read_message_id_client" : "last_read_message_id_freelancer";

    const { data: chatsData, error } = await supabaseClient
        .from("chats")
        .select(`id, latest_message_id, ${lastReadColumn}`)
        .eq(column, userId);

    if (error || !chatsData) {
        console.log("Error occurred in getUnseenChatsCount function", error?.message);
        return 0;
    }

    // If no chats, return 0 immediately
    if (chatsData.length === 0) {
        return 0;
    }

    // Get chat IDs
    const chatIds = chatsData.map((chat: any) => chat.id);
    
    // Fetch messages to check sender role
    const { data: messagesData, error: messagesError } = await supabaseClient
        .from("messages")
        .select("id, chat_id, sender_role")
        .in("chat_id", chatIds)
        .order("created_at", { ascending: false });

    if (messagesError) {
        console.log("Error fetching messages in getUnseenChatsCount", messagesError.message);
        return 0;
    }

    // If no messages, return 0
    if (!messagesData || messagesData.length === 0) {
        return 0;
    }

    // Count chats with unseen messages from OTHER person
    const unseenCount = chatsData.filter((chat: any) => {
        const lastReadMessageId = chat[lastReadColumn];
        
        // Get unread messages for this chat from other person
        const unreadFromOther = messagesData?.filter((msg: any) => 
            msg.chat_id === chat.id && 
            msg.sender_role !== userRole &&
            (!lastReadMessageId || msg.id > lastReadMessageId)
        );
        
        return unreadFromOther && unreadFromOther.length > 0;
    }).length;

    return unseenCount;
}

export async function createEmptyChat({
    freelancerId,
    clientId,
}: {
    freelancerId: string;
    clientId: string;
}): Promise<string> {
    console.log("createEmptyChat() called");

    const { data, error } = await supabaseClient
        .from("chats")
        .insert([{ freelancer_id: freelancerId, client_id: clientId }])
        .select()
        .single();

    if (error) {
        console.log(
            "Error occurred in createEmptyChat function",
            error.message
        );
        throw new Error(error.message);
    }

    return data.id;
}

export async function createChatAndInsertMessage({
    freelancerId,
    clientId,
    message,
}: {
    freelancerId: string;
    clientId: string;
    message: string;
}): Promise<string> {
    console.log("createChatAndInsertMessage() called");

    const { data, error } = await supabaseClient
        .from("chats")
        .insert([{ freelancer_id: freelancerId, client_id: clientId }])
        .select()
        .single();

    if (error) {
        console.log(
            "Error occurred in createChatAndInsertMessage function",
            error.message
        );
        throw new Error(error.message);
    }

    const { error: messageError, data: messageResponse } = await supabaseClient
        .from("messages")
        .insert([
            {
                chat_id: data.id,
                freelancer_id: freelancerId,
                client_id: clientId,
                message_text: message,
                sender_role: "client",
            },
        ])
        .select("id")
        .single();

    if (messageError) {
        console.log(
            "Error occurred in createChatAndInsertMessage function",
            messageError.message
        );
        throw new Error(messageError.message);
    }

    const newMessageId = messageResponse.id;

    const { error: chatUpdateError } = await supabaseClient
        .from("chats")
        .update({
            latest_message_id: newMessageId,
        })
        .eq("id", data.id);

    if (chatUpdateError) {
        console.log(
            "Error occurred in createChatAndInsertMessage function",
            chatUpdateError.message
        );
        throw new Error(chatUpdateError.message);
    }

    return data.id;
}

export async function getMessagesForChat(
    chatId: string
): Promise<MessageFromBackendType[]> {
    console.log("getMessagesForChat() called");

    const { data, error } = await supabaseClient
        .from("messages")
        .select("*")
        .eq("chat_id", chatId)
        .order("created_at", { ascending: true });

    if (error) {
        console.error("Error occurred in getMessagesForChat function", error.message);
        throw new Error(error.message);
    }

    return data;
}

export async function sendMessage(
    chatId: string,
    freelancerId: string,
    clientId: string,
    senderRole: "client" | "freelancer",
    messageText: string
): Promise<void> {
    console.log("sendMessage() called");

    const { error, data } = await supabaseClient
        .from("messages")
        .insert([
            {
                chat_id: chatId,
                freelancer_id: freelancerId,
                client_id: clientId,
                sender_role: senderRole,
                message_text: messageText,
            },
        ])
        .select("id")
        .single();

    if (error) {
        console.log("Error occurred in sendMessage function", error.message);
        throw new Error(error.message);
    }

    if (!data || !data.id) {
        console.log(
            "Error occurred in sendMessage function, inserted message data or id missing"
        );
        throw new Error("Inserted message data or id missing");
    }

    const { error: chatUpdateError } = await supabaseClient
        .from("chats")
        .update({
            latest_message_id: data.id,
            last_updated_by: senderRole === "client" ? clientId : freelancerId,
        })
        .eq("id", chatId);

    if (chatUpdateError) {
        console.log("Error occurred in sendMessage function", chatUpdateError.message);
        throw new Error(chatUpdateError.message);
    }
}

export async function getMessagesForProject(
    projectId: string
): Promise<ProjectMessageFromBackendType[]> {
    const { error, data } = await supabaseClient
        .from("project_messages")
        .select("*")
        .eq("project_id", projectId)
        .order("created_at", { ascending: true });

    if (error) {
        console.error("Error occurred in getMessagesForProject function", error.message);
        throw new Error(error.message);
    }

    // Fetch sender details for each message
    const messagesWithSenderDetails = await Promise.all(
        data.map(async (message) => {
            // Try fetching from clients first
            let senderDetails = null;
            const { data: clientData } = await supabaseClient
                .from("clients")
                .select("profile_pic, role")
                .eq("id", message.sender_id)
                .maybeSingle();

            if (clientData) {
                senderDetails = clientData;
            } else {
                // If not a client, try freelancers
                const { data: freelancerData } = await supabaseClient
                    .from("freelancers")
                    .select("profile_pic, role")
                    .eq("id", message.sender_id)
                    .maybeSingle();
                
                if (freelancerData) {
                    senderDetails = freelancerData;
                }
            }

            return {
                ...message,
                sender_profile_pic: senderDetails?.profile_pic || null,
                sender_role: senderDetails?.role || 'client',
            };
        })
    );

    return messagesWithSenderDetails;
}

export async function sendProjectChatMessage(
    projectId: string,
    senderId: string,
    senderUsername: string,
    messageText: string
): Promise<void> {
    // Removed excessive logging - only log errors
    const { error } = await supabaseClient.from("project_messages").insert([
        {
            project_id: projectId,
            sender_id: senderId,
            sender_username: senderUsername,
            message_text: messageText,
        },
    ]);

    if (error) {
        console.error("Error occurred in sendProjectChatMessage function", error.message);
        throw new Error(error.message);
    }
}

export async function updateLastReadMessage(
    chatId: string,
    userRole: "client" | "freelancer",
    lastMessageId: number
): Promise<void> {
    console.log("updateLastReadMessage() called");
    const column =
        userRole === "client"
            ? "last_read_message_id_client"
            : "last_read_message_id_freelancer";

    const { error } = await supabaseClient
        .from("chats")
        .update({ [column]: lastMessageId })
        .eq("id", chatId)
        .select();

    if (error) {
        console.error("Error occurred in updateLastReadMessage function", error.message);
        throw new Error(error.message);
    }
}

export async function uploadChatMedia({
    fileUri,
    fileName,
    userId,
    chatId,
    clientId,
    freelancerId,
    senderRole,
}: {
    fileUri: string;
    fileName: string;
    userId: string;
    chatId: string;
    freelancerId: string;
    clientId: string;
    senderRole: "client" | "freelancer";
}) {
    console.log("uploadChatMedia() called");

    const uniqueFileName = `${Date.now()}_${userId}_${fileName}`;
    const filePath = `chat-files/${uniqueFileName}`;

    // Read file as base64
    const base64 = await FileSystem.readAsStringAsync(fileUri, {
        encoding: FileSystem.EncodingType.Base64,
    });

    // Convert base64 to blob
    const arrayBuffer = Uint8Array.from(atob(base64), c => c.charCodeAt(0));

    const { error } = await supabaseClient.storage
        .from("project-media")
        .upload(filePath, arrayBuffer, {
            upsert: false,
            cacheControl: "3600",
        });

    if (error) {
        console.error("Error occurred in uploadChatMedia function", error.message);
        throw new Error(error.message);
    }

    const { data: fileData } = supabaseClient.storage
        .from("project-media")
        .getPublicUrl(filePath);

    const ext = fileName.split(".").pop()?.toLowerCase() || "file";

    const { error: messageError, data: messageData } = await supabaseClient
        .from("messages")
        .insert([
            {
                chat_id: chatId,
                freelancer_id: freelancerId,
                client_id: clientId,
                sender_role: senderRole,
                message_text: fileData.publicUrl,
                file_type: ext,
            },
        ]);
    if (messageError) {
        console.error("Error occurred in uploadChatMedia function", messageError.message);
        throw new Error(messageError.message);
    }

    console.log("message data:", messageData);
}




